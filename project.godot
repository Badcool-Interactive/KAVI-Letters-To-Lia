; Engine configuration file.
config_version=5

[application]
config/name="KAVI: Letters to Lia"
config/description="KAVI: Letters to Lia. A little courier robot carries letters across Europe to reach his friend Lia. By BADCOOL INTERACTIVE."
config/use_custom_user_dir=true
config/custom_user_dir_name="BADCOOL INTERACTIVE/KAVI"
config/version="0.8.33"
run/main_scene="res://main.tscn"
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/image="res://assets/splash.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true
config/features=PackedStringArray("4.7", "Mobile")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]
pointing/emulate_touch_from_mouse=false

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=10
common/physics_interpolation=false

[rendering]
renderer/rendering_method="mobile"
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.06, 1)
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
