; Engine configuration file.
config_version=5

[application]
config/name="VOLT/RUN"
config/description="Kite runs across a luminous future Europe to reach Lumi."
config/version="0.4.0"
run/main_scene="res://main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7", "Mobile")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]
pointing/emulate_touch_from_mouse=false

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=10
common/physics_interpolation=false

[rendering]
renderer/rendering_method="mobile"
viewport/hdr_2d=true
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.06, 1)
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
